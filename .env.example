# Configuración para desarrollo local

# Proveedor de IA (kimi o claude)
# Por defecto se usa Kimi K2.5
AI_PROVIDER=kimi

# API Key de Kimi (Moonshot AI) - RECOMENDADO
# Obtén tu key en: https://platform.moonshot.ai/
KIMI_API_KEY=sk-xxxxxxxxxxxxx

# API Key de Anthropic Claude (opcional)
# Obtén tu key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Token de GitHub (para pruebas locales)
# Genera uno en: https://github.com/settings/tokens
# Permisos necesarios: repo, read:org
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
