{
  "name": "@lucaford/ai-code-reviewer",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered code review agent for GitHub Pull Requests using Kimi K2.5 or Claude 3.5 Sonnet",
  "main": "dist/index.js",
  "bin": {
    "ai-code-reviewer": "./cli/cli.js"
  },
  "files": [
    "dist",
    "src",
    "cli",
    ".github/workflows/code-review.yml",
    "tsconfig.json",
    ".reviewrc.example.json",
    ".reviewrc.schema.json",
    "README.md",
    "QUICKSTART.md",
    "RULES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "code-review",
    "ai",
    "claude",
    "kimi",
    "automation",
    "pull-request",
    "github-actions",
    "code-quality",
    "static-analysis"
  ],
  "author": "Lucas Ford <lucaford@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucaford/ai-code-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/lucaford/ai-code-reviewer/issues"
  },
  "homepage": "https://github.com/lucaford/ai-code-reviewer#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@anthropic-ai/sdk": "^0.78.0",
    "@octokit/rest": "^22.0.1",
    "openai": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
